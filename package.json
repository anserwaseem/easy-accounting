{
  "version": "0.4.0",
  "description": "Easy Accounting is a simple accounting software for SMEs.",
  "keywords": [
    "easyAccounting",
    "accounting software",
    "electron",
    "react",
    "typescript",
    "ts",
    "sass",
    "webpack"
  ],
  "homepage": "https://github.com/anserwaseem/easy-accouting#readme",
  "bugs": {
    "url": "https://github.com/anserwaseem/easy-accouting/issues"
  },
  "repository": {
    "type": "git",
    "url": "git+https://github.com/anserwaseem/easy-accouting.git"
  },
  "license": "MIT",
  "author": {
    "name": "Anser Waseem",
    "email": "hafiz.anser.waseem@gmail.com",
    "url": "https://anserwaseem.com"
  },
  "main": "./src/main/main.ts",
  "type": "commonjs",
  "scripts": {
    "build": "concurrently \"npm run build:main\" \"npm run build:renderer\"",
    "build:main": "cross-env NODE_ENV=production TS_NODE_TRANSPILE_ONLY=true webpack --config ./.erb/configs/webpack.config.main.prod.ts",
    "build:renderer": "cross-env NODE_ENV=production TS_NODE_TRANSPILE_ONLY=true webpack --config ./.erb/configs/webpack.config.renderer.prod.ts",
    "clean": "ts-node ./.erb/scripts/clean.js dist",
    "rebuild": "electron-rebuild --parallel --types prod,dev,optional --module-dir release/app",
    "postinstall": "node .erb/scripts/electron-postinstall.js",
    "prepackage": "ts-node .erb/scripts/prepackage-db.ts",
    "package": "npm run clean && npm run build && electron-builder",
    "postpackage": "ts-node .erb/scripts/postpackage-db.ts",
    "package:win": "npm run package -- --win",
    "package:mac": "npm run package -- --mac",
    "release": "npm run package -- --mac --win -p always",
    "start": "cross-env PORT=3001 ts-node ./.erb/scripts/check-port-in-use.js && npm run start:renderer",
    "start:main": "cross-env NODE_ENV=development electronmon -r ts-node/register/transpile-only .",
    "start:preload": "cross-env NODE_ENV=development TS_NODE_TRANSPILE_ONLY=true webpack --config ./.erb/configs/webpack.config.preload.dev.ts",
    "start:renderer": "cross-env PORT=3001 NODE_ENV=development TS_NODE_TRANSPILE_ONLY=true webpack serve --config ./.erb/configs/webpack.config.renderer.dev.ts",
    "test": "ELECTRON_RUN_AS_NODE=true ./node_modules/.bin/electron ./node_modules/.bin/jest --watchAll=false",
    "typecheck": "tsc --noEmit -p tsconfig.json",
    "verify": "npm run lint && npm run typecheck && npm test",
    "web": "npm --prefix apps/web run dev",
    "web:build": "npm --prefix apps/web run build",
    "lint": "eslint \"**/*.{js,jsx,ts,tsx}\"",
    "lint:fix": "eslint \"**/*.{js,jsx,ts,tsx}\" --fix",
    "prepare": "husky",
    "patch": "npm version patch --no-git-tag-version",
    "patch:release": "npm run patch && npm --prefix release/app run patch && npm --prefix apps/web run patch"
  },
  "lint-staged": {
    "*.{js,jsx,ts,tsx}": [
      "prettier --write \"**/*.{js,jsx,ts,tsx,md}\"",
      "eslint --cache --fix"
    ]
  },
  "browserslist": [],
  "dependencies": {
    "@aws-sdk/client-s3": "^3.1161.0",
    "@hookform/resolvers": "^5.6.0",
    "cmdk": "^1.1.1",
    "electron-debug": "^3.2.0",
    "electron-extension-installer": "^2.0.3",
    "electron-log": "^4.4.8",
